# ── Config dos testes de QA do módulo financeiro ─────────────────────────────
# Copie para tests/.env e preencha. NÃO comite tests/.env.

# Conexão (as mesmas do app; anon key basta — os testes autenticam por login)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Usuário admin OU manager (necessário para as RPCs financeiras)
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Opcional: usuário com papel 'factory' (para testar o vazamento de RLS #1).
# Sem isto, o teste de RLS do operador é pulado (skip), não falha.
QA_FACTORY_EMAIL=
QA_FACTORY_PASSWORD=

# TRAVA DE SEGURANÇA: os testes de integração ESCREVEM no banco (criam e apagam
# obrigações de teste marcadas com [QA-TEST]). Deixe em 1 só quando for seguro
# (idealmente um projeto Supabase de staging, não produção).
QA_ALLOW_WRITES=0

# Opcional: id de uma conta bancária ATIVA e descartável para o teste de
# pagamento→recebido. Sem isto, esse teste específico é pulado.
QA_BANK_ACCOUNT_ID=
