


SET statement_timeout = 0;
SET lock_timeout = 0;
SET idle_in_transaction_session_timeout = 0;
SET client_encoding = 'UTF8';
SET standard_conforming_strings = on;
SELECT pg_catalog.set_config('search_path', '', false);
SET check_function_bodies = false;
SET xmloption = content;
SET client_min_messages = warning;
SET row_security = off;


CREATE SCHEMA IF NOT EXISTS "public";


ALTER SCHEMA "public" OWNER TO "postgres";


CREATE TYPE "public"."global_category_domain" AS ENUM (
    'finance',
    'inventory',
    'crm'
);


ALTER TYPE "public"."global_category_domain" OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."assert_finance_access"() RETURNS "void"
    LANGUAGE "plpgsql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
BEGIN
  IF auth.uid() IS NULL OR NOT public.is_admin_or_manager() THEN
    RAISE EXCEPTION 'Acesso financeiro negado';
  END IF;
END;
$$;


ALTER FUNCTION "public"."assert_finance_access"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."cancel_obligation"("p_obligation_id" "uuid", "p_reason" "text" DEFAULT NULL::"text") RETURNS "void"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
BEGIN
  PERFORM public.assert_finance_access();

  IF EXISTS (
    SELECT 1
    FROM public.obligation_payments
    JOIN public.financial_obligations
      ON financial_obligations.id = obligation_payments.obligation_id
    WHERE obligation_payments.obligation_id = p_obligation_id
      AND obligation_payments.reversed_at IS NULL
      AND obligation_payments.reversal_of IS NULL
  ) THEN
    RAISE EXCEPTION 'Nao e possivel cancelar: existem pagamentos ativos';
  END IF;

  UPDATE public.financial_obligations
  SET status = 'cancelled',
      cancelled_at = now(),
      cancelled_reason = p_reason,
      updated_at = now()
  WHERE id = p_obligation_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Obligation not found: %', p_obligation_id;
  END IF;
END;
$$;


ALTER FUNCTION "public"."cancel_obligation"("p_obligation_id" "uuid", "p_reason" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."create_recurrence_obligations"("p_type" "text", "p_description" "text", "p_amount" numeric, "p_first_due" "date", "p_months" integer, "p_category" "text" DEFAULT NULL::"text", "p_cost_center" "uuid" DEFAULT NULL::"uuid", "p_client_id" "uuid" DEFAULT NULL::"uuid", "p_supplier_id" "uuid" DEFAULT NULL::"uuid", "p_account_id" "uuid" DEFAULT NULL::"uuid", "p_notes" "text" DEFAULT NULL::"text", "p_global_category_id" "uuid" DEFAULT NULL::"uuid", "p_order_id" "uuid" DEFAULT NULL::"uuid") RETURNS "uuid"[]
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
DECLARE
  v_recurrence_id uuid := gen_random_uuid();
  v_ids uuid[] := ARRAY[]::uuid[];
  v_id uuid;
  v_due_date date;
  i integer;
BEGIN
  PERFORM public.assert_finance_access();

  IF p_type NOT IN ('receivable', 'payable') THEN
    RAISE EXCEPTION 'Invalid obligation type: %', p_type;
  END IF;

  IF p_amount IS NULL OR p_amount <= 0 THEN
    RAISE EXCEPTION 'Amount must be positive';
  END IF;

  IF p_months IS NULL OR p_months < 1 OR p_months > 120 THEN
    RAISE EXCEPTION 'Invalid recurrence length';
  END IF;

  IF p_client_id IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM public.clients WHERE id = p_client_id
  ) THEN
    RAISE EXCEPTION 'Client not found';
  END IF;

  IF p_supplier_id IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM public.suppliers WHERE id = p_supplier_id
  ) THEN
    RAISE EXCEPTION 'Supplier not found';
  END IF;

  IF p_account_id IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM public.bank_accounts WHERE id = p_account_id AND is_active
  ) THEN
    RAISE EXCEPTION 'Bank account not found or inactive';
  END IF;

  IF p_order_id IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM public.orders WHERE id = p_order_id
  ) THEN
    RAISE EXCEPTION 'Order not found';
  END IF;

  IF p_global_category_id IS NOT NULL AND NOT EXISTS (
    SELECT 1
    FROM public.global_categories
    WHERE id = p_global_category_id
      AND domain = 'finance'
      AND is_active
  ) THEN
    RAISE EXCEPTION 'Global finance category not found or inactive';
  END IF;

  FOR i IN 1..p_months LOOP
    v_id := gen_random_uuid();
    v_due_date := (p_first_due + ((i - 1) || ' months')::interval)::date;

    INSERT INTO public.financial_obligations (
      id,
      user_id,
      type,
      status,
      description,
      original_amount,
      due_date,
      issue_date,
      category,
      cost_center_id,
      client_id,
      supplier_id,
      default_account_id,
      notes,
      is_recurring,
      recurrence_id,
      installment_no,
      total_installments,
      global_category_id,
      order_id
    ) VALUES (
      v_id,
      auth.uid(),
      p_type,
      'open',
      p_description || CASE
        WHEN p_months > 1 THEN ' (' || i || '/' || p_months || ')'
        ELSE ''
      END,
      p_amount,
      v_due_date,
      CURRENT_DATE,
      p_category,
      p_cost_center,
      p_client_id,
      p_supplier_id,
      p_account_id,
      p_notes,
      p_months > 1,
      CASE WHEN p_months > 1 THEN v_recurrence_id ELSE NULL END,
      i,
      p_months,
      p_global_category_id,
      p_order_id
    );

    v_ids := array_append(v_ids, v_id);
  END LOOP;

  RETURN v_ids;
END;
$$;


ALTER FUNCTION "public"."create_recurrence_obligations"("p_type" "text", "p_description" "text", "p_amount" numeric, "p_first_due" "date", "p_months" integer, "p_category" "text", "p_cost_center" "uuid", "p_client_id" "uuid", "p_supplier_id" "uuid", "p_account_id" "uuid", "p_notes" "text", "p_global_category_id" "uuid", "p_order_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."current_user_role"() RETURNS "text"
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT role
  FROM public.profiles
  WHERE id = auth.uid()
$$;


ALTER FUNCTION "public"."current_user_role"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."get_aging_buckets"("p_reference_date" "date" DEFAULT CURRENT_DATE) RETURNS TABLE("obligation_type" "text", "bucket" "text", "cnt" bigint, "total_amount" numeric)
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  RETURN QUERY
  SELECT
    os.type AS obligation_type,
    CASE
      WHEN os.due_date >= p_reference_date                           THEN 'current'
      WHEN os.due_date >= p_reference_date - INTERVAL '30 days'     THEN '1_30'
      WHEN os.due_date >= p_reference_date - INTERVAL '60 days'     THEN '31_60'
      ELSE '60_plus'
    END AS bucket,
    COUNT(*)::bigint AS cnt,
    SUM(os.remaining_amount) AS total_amount
  FROM obligation_summary os
  WHERE os.derived_status NOT IN ('paid', 'cancelled')
  GROUP BY os.type, bucket;
END;
$$;


ALTER FUNCTION "public"."get_aging_buckets"("p_reference_date" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."get_cash_position"("p_start" "date" DEFAULT NULL::"date", "p_end" "date" DEFAULT NULL::"date") RETURNS TABLE("projected_balance" numeric, "reconciled_balance" numeric, "net_flow" numeric, "total_receivable" numeric, "total_payable" numeric)
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  RETURN QUERY
  SELECT
    COALESCE((SELECT SUM(current_balance) FROM bank_accounts WHERE is_active), 0) +
      COALESCE((SELECT SUM(remaining_amount) FROM obligation_summary
                WHERE type = 'receivable' AND derived_status NOT IN ('paid','cancelled')
                  AND (p_start IS NULL OR due_date >= p_start)
                  AND (p_end IS NULL OR due_date <= p_end)), 0) -
      COALESCE((SELECT SUM(remaining_amount) FROM obligation_summary
                WHERE type = 'payable' AND derived_status NOT IN ('paid','cancelled')
                  AND (p_start IS NULL OR due_date >= p_start)
                  AND (p_end IS NULL OR due_date <= p_end)), 0) AS projected_balance,
    (SELECT SUM(current_balance) FROM bank_accounts WHERE is_active) AS reconciled_balance,
    COALESCE((SELECT SUM(remaining_amount) FROM obligation_summary
              WHERE type = 'receivable' AND derived_status NOT IN ('paid','cancelled')
                AND (p_start IS NULL OR due_date >= p_start)
                AND (p_end IS NULL OR due_date <= p_end)), 0) -
    COALESCE((SELECT SUM(remaining_amount) FROM obligation_summary
              WHERE type = 'payable' AND derived_status NOT IN ('paid','cancelled')
                AND (p_start IS NULL OR due_date >= p_start)
                AND (p_end IS NULL OR due_date <= p_end)), 0) AS net_flow,
    COALESCE((SELECT SUM(remaining_amount) FROM obligation_summary
              WHERE type = 'receivable' AND derived_status NOT IN ('paid','cancelled')
                AND (p_start IS NULL OR due_date >= p_start)
                AND (p_end IS NULL OR due_date <= p_end)), 0) AS total_receivable,
    COALESCE((SELECT SUM(remaining_amount) FROM obligation_summary
              WHERE type = 'payable' AND derived_status NOT IN ('paid','cancelled')
                AND (p_start IS NULL OR due_date >= p_start)
                AND (p_end IS NULL OR due_date <= p_end)), 0) AS total_payable;
END;
$$;


ALTER FUNCTION "public"."get_cash_position"("p_start" "date", "p_end" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."get_cashflow_series"("p_start" "date", "p_end" "date") RETURNS TABLE("series_date" "date", "inflow" numeric, "outflow" numeric, "balance" numeric)
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  RETURN QUERY
  WITH daily AS (
    SELECT
      op.payment_date AS series_date,
      SUM(CASE WHEN fo.type = 'receivable' THEN op.amount ELSE 0 END) AS inflow,
      SUM(CASE WHEN fo.type = 'payable'    THEN op.amount ELSE 0 END) AS outflow
    FROM obligation_payments op
    JOIN financial_obligations fo ON fo.id = op.obligation_id
    WHERE op.reversed_at IS NULL
      AND op.reversal_of IS NULL
      AND op.payment_date BETWEEN p_start AND p_end
    GROUP BY op.payment_date
  )
  SELECT
    d.series_date,
    d.inflow,
    d.outflow,
    SUM(d.inflow - d.outflow) OVER (ORDER BY d.series_date) AS balance
  FROM daily d
  ORDER BY d.series_date;
END;
$$;


ALTER FUNCTION "public"."get_cashflow_series"("p_start" "date", "p_end" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."get_liquidity_kpis"("p_start" "date", "p_end" "date") RETURNS TABLE("pmr_days" numeric, "pmp_days" numeric, "cce_days" numeric, "coverage_days" numeric, "avg_daily_outflow" numeric)
    LANGUAGE "plpgsql"
    AS $$
DECLARE
  v_pmr      numeric;
  v_pmp      numeric;
  v_coverage numeric;
  v_avg_out  numeric;
BEGIN
  -- PMR: média de dias entre issue_date e payment_date (recebíveis pagos)
  SELECT AVG(op.payment_date - fo.issue_date)
    INTO v_pmr
  FROM obligation_payments op
  JOIN financial_obligations fo ON fo.id = op.obligation_id
  WHERE fo.type = 'receivable'
    AND op.reversed_at IS NULL
    AND op.reversal_of IS NULL
    AND fo.issue_date BETWEEN p_start AND p_end;

  -- PMP: média de dias entre issue_date e payment_date (pagáveis pagos)
  SELECT AVG(op.payment_date - fo.issue_date)
    INTO v_pmp
  FROM obligation_payments op
  JOIN financial_obligations fo ON fo.id = op.obligation_id
  WHERE fo.type = 'payable'
    AND op.reversed_at IS NULL
    AND op.reversal_of IS NULL
    AND fo.issue_date BETWEEN p_start AND p_end;

  -- Avg daily outflow
  SELECT COALESCE(SUM(op.amount) / NULLIF((p_end - p_start), 0), 0)
    INTO v_avg_out
  FROM obligation_payments op
  JOIN financial_obligations fo ON fo.id = op.obligation_id
  WHERE fo.type = 'payable'
    AND op.reversed_at IS NULL
    AND op.reversal_of IS NULL
    AND op.payment_date BETWEEN p_start AND p_end;

  -- Coverage days: saldo atual / avg_daily_outflow
  SELECT CASE WHEN v_avg_out > 0
              THEN (SELECT SUM(current_balance) FROM bank_accounts WHERE is_active) / v_avg_out
              ELSE NULL END
    INTO v_coverage;

  RETURN QUERY SELECT
    ROUND(v_pmr, 1),
    ROUND(v_pmp, 1),
    ROUND(COALESCE(v_pmr, 0) - COALESCE(v_pmp, 0), 1),
    ROUND(v_coverage, 1),
    ROUND(v_avg_out, 2);
END;
$$;


ALTER FUNCTION "public"."get_liquidity_kpis"("p_start" "date", "p_end" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."handle_new_user"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
BEGIN
  INSERT INTO public.profiles (id, email, role, full_name)
  VALUES (NEW.id, NEW.email, 'factory', NEW.raw_user_meta_data->>'full_name')
  ON CONFLICT (id) DO NOTHING;

  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."handle_new_user"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."is_admin_or_manager"() RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT COALESCE(public.current_user_role() IN ('admin', 'manager'), false)
$$;


ALTER FUNCTION "public"."is_admin_or_manager"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."is_factory"() RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT COALESCE(public.current_user_role() = 'factory', false)
$$;


ALTER FUNCTION "public"."is_factory"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."pay_obligation"("p_obligation_id" "uuid", "p_amount" numeric, "p_account_id" "uuid", "p_method" "text" DEFAULT 'PIX'::"text", "p_payment_date" "date" DEFAULT CURRENT_DATE, "p_notes" "text" DEFAULT NULL::"text", "p_attachments" "jsonb" DEFAULT '[]'::"jsonb") RETURNS "uuid"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
DECLARE
  v_payment_id uuid;
  v_obligation public.financial_obligations%ROWTYPE;
  v_paid numeric;
  v_remaining numeric;
  v_delta numeric;
BEGIN
  PERFORM public.assert_finance_access();

  IF p_amount IS NULL OR p_amount <= 0 THEN
    RAISE EXCEPTION 'Payment amount must be positive';
  END IF;

  SELECT *
  INTO v_obligation
  FROM public.financial_obligations
  WHERE id = p_obligation_id
  FOR UPDATE;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Obligation not found: %', p_obligation_id;
  END IF;

  IF v_obligation.cancelled_at IS NOT NULL OR v_obligation.status = 'cancelled' THEN
    RAISE EXCEPTION 'Cannot pay a cancelled obligation';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM public.bank_accounts
    WHERE id = p_account_id
      AND is_active
  ) THEN
    RAISE EXCEPTION 'Bank account not found or inactive: %', p_account_id;
  END IF;

  SELECT COALESCE(SUM(amount), 0)
  INTO v_paid
  FROM public.obligation_payments
  WHERE obligation_id = p_obligation_id
    AND reversed_at IS NULL
    AND reversal_of IS NULL;

  v_remaining := v_obligation.original_amount - v_paid;
  IF p_amount > v_remaining THEN
    RAISE EXCEPTION 'Payment amount exceeds remaining balance';
  END IF;

  v_delta := CASE
    WHEN v_obligation.type = 'receivable' THEN p_amount
    ELSE -p_amount
  END;

  INSERT INTO public.obligation_payments (
    user_id,
    obligation_id,
    amount,
    payment_date,
    account_id,
    method,
    notes,
    attachments
  ) VALUES (
    auth.uid(),
    p_obligation_id,
    p_amount,
    p_payment_date,
    p_account_id,
    p_method,
    p_notes,
    COALESCE(p_attachments, '[]')
  )
  RETURNING id INTO v_payment_id;

  PERFORM public.update_bank_balance(p_account_id, v_delta);

  UPDATE public.financial_obligations
  SET status = (
        SELECT derived_status
        FROM public.obligation_summary
        WHERE id = p_obligation_id
      ),
      updated_at = now()
  WHERE id = p_obligation_id;

  RETURN v_payment_id;
END;
$$;


ALTER FUNCTION "public"."pay_obligation"("p_obligation_id" "uuid", "p_amount" numeric, "p_account_id" "uuid", "p_method" "text", "p_payment_date" "date", "p_notes" "text", "p_attachments" "jsonb") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."recalculate_all_bank_balances"() RETURNS "void"
    LANGUAGE "plpgsql" SECURITY DEFINER
    AS $$
DECLARE r record;
BEGIN
  FOR r IN SELECT id FROM bank_accounts WHERE user_id = auth.uid() LOOP
    UPDATE bank_accounts
      SET current_balance = initial_balance + COALESCE((
        SELECT SUM(CASE WHEN fo.type = 'receivable' THEN op.amount ELSE -op.amount END)
        FROM obligation_payments op
        JOIN financial_obligations fo ON fo.id = op.obligation_id
        WHERE op.account_id = r.id
          AND op.reversed_at IS NULL
          AND op.reversal_of IS NULL
      ), 0),
      updated_at = NOW()
    WHERE id = r.id;
  END LOOP;
END;
$$;


ALTER FUNCTION "public"."recalculate_all_bank_balances"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."reverse_payment"("p_payment_id" "uuid", "p_reason" "text" DEFAULT NULL::"text") RETURNS "void"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
DECLARE
  v_pay public.obligation_payments%ROWTYPE;
  v_type text;
  v_delta numeric;
  v_reversal_id uuid;
BEGIN
  PERFORM public.assert_finance_access();

  SELECT obligation_payments.*
  INTO v_pay
  FROM public.obligation_payments
  JOIN public.financial_obligations
    ON financial_obligations.id = obligation_payments.obligation_id
  WHERE obligation_payments.id = p_payment_id
  FOR UPDATE;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Payment not found: %', p_payment_id;
  END IF;

  IF v_pay.reversed_at IS NOT NULL THEN
    RAISE EXCEPTION 'Payment already reversed';
  END IF;

  IF v_pay.reversal_of IS NOT NULL THEN
    RAISE EXCEPTION 'Nao e permitido estornar um registro de estorno';
  END IF;

  SELECT type
  INTO v_type
  FROM public.financial_obligations
  WHERE id = v_pay.obligation_id;

  v_delta := CASE
    WHEN v_type = 'receivable' THEN -v_pay.amount
    ELSE v_pay.amount
  END;

  UPDATE public.obligation_payments
  SET reversed_at = now(),
      reversed_by = NULL
  WHERE id = p_payment_id;

  INSERT INTO public.obligation_payments (
    user_id,
    obligation_id,
    amount,
    payment_date,
    account_id,
    method,
    notes,
    reversal_of
  ) VALUES (
    auth.uid(),
    v_pay.obligation_id,
    v_pay.amount,
    CURRENT_DATE,
    v_pay.account_id,
    v_pay.method,
    COALESCE(p_reason, 'Estorno'),
    p_payment_id
  )
  RETURNING id INTO v_reversal_id;

  UPDATE public.obligation_payments
  SET reversed_by = v_reversal_id
  WHERE id = p_payment_id;

  PERFORM public.update_bank_balance(v_pay.account_id, v_delta);

  UPDATE public.financial_obligations
  SET status = (
        SELECT derived_status
        FROM public.obligation_summary
        WHERE id = v_pay.obligation_id
      ),
      updated_at = now()
  WHERE id = v_pay.obligation_id;
END;
$$;


ALTER FUNCTION "public"."reverse_payment"("p_payment_id" "uuid", "p_reason" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."set_updated_at"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."set_updated_at"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."toggle_reconciliation"("p_obligation_id" "uuid") RETURNS boolean
    LANGUAGE "plpgsql"
    AS $$
DECLARE
  v_new boolean;
BEGIN
  UPDATE financial_obligations
    SET is_reconciled = NOT is_reconciled,
        updated_at    = NOW()
  WHERE id = p_obligation_id
  RETURNING is_reconciled INTO v_new;
  RETURN v_new;
END;
$$;


ALTER FUNCTION "public"."toggle_reconciliation"("p_obligation_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."undo_reconciliation"("p_obligation_id" "uuid", "p_reason" "text" DEFAULT NULL::"text") RETURNS boolean
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  UPDATE financial_obligations
    SET is_reconciled       = false,
        unreconciled_reason = p_reason,
        unreconciled_at     = NOW(),
        updated_at          = NOW()
  WHERE id = p_obligation_id;
  RETURN true;
END;
$$;


ALTER FUNCTION "public"."undo_reconciliation"("p_obligation_id" "uuid", "p_reason" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."update_bank_balance"("p_account_id" "uuid", "p_delta" numeric) RETURNS "void"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
BEGIN
  PERFORM public.assert_finance_access();

  UPDATE public.bank_accounts
  SET current_balance = current_balance + p_delta,
      updated_at = now()
  WHERE id = p_account_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Bank account not found: %', p_account_id;
  END IF;
END;
$$;


ALTER FUNCTION "public"."update_bank_balance"("p_account_id" "uuid", "p_delta" numeric) OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."update_insumo_stock_and_cost"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
DECLARE
  v_insumo record;
  v_new_qty numeric;
  v_new_cost numeric;
BEGIN
  IF NEW.quantity IS NULL OR NEW.quantity <= 0 THEN
    RAISE EXCEPTION 'Movement quantity must be positive';
  END IF;

  SELECT *
  INTO v_insumo
  FROM public.insumos
  WHERE id = NEW.insumo_id
  FOR UPDATE;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Insumo not found';
  END IF;

  IF NEW.type = 'IN' THEN
    IF NEW.unit_cost IS NULL OR NEW.unit_cost <= 0 THEN
      RAISE EXCEPTION 'Unit cost must be positive for stock entry';
    END IF;

    v_new_qty := v_insumo.current_stock + NEW.quantity;
    v_new_cost := (
      (v_insumo.current_stock * v_insumo.average_unit_cost)
      + (NEW.quantity * NEW.unit_cost)
    ) / NULLIF(v_new_qty, 0);
    NEW.total_cost := COALESCE(NEW.total_cost, NEW.quantity * NEW.unit_cost);
  ELSIF NEW.type = 'OUT' THEN
    IF v_insumo.current_stock < NEW.quantity THEN
      RAISE EXCEPTION 'Insufficient stock for insumo %', NEW.insumo_id;
    END IF;

    v_new_qty := v_insumo.current_stock - NEW.quantity;
    v_new_cost := v_insumo.average_unit_cost;
    NEW.unit_cost := v_insumo.average_unit_cost;
    NEW.total_cost := NEW.quantity * v_insumo.average_unit_cost;
  ELSE
    RAISE EXCEPTION 'Invalid movement type. Must be IN or OUT.';
  END IF;

  UPDATE public.insumos
  SET current_stock = v_new_qty,
      average_unit_cost = COALESCE(v_new_cost, 0),
      updated_at = now()
  WHERE id = NEW.insumo_id;

  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."update_insumo_stock_and_cost"() OWNER TO "postgres";

