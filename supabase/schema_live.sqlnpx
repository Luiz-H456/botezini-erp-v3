CREATE OR REPLACE VIEW "public"."obligation_summary" AS
 SELECT "o"."id",
    "o"."user_id",
    "o"."type",
    "o"."status",
    "o"."description",
    "o"."original_amount",
    "o"."due_date",
    "o"."issue_date",
    "o"."category",
    "o"."cost_center_id",
    "o"."notes",
    "o"."client_id",
    "o"."supplier_id",
    "o"."default_account_id",
    "o"."is_recurring",
    "o"."recurrence_id",
    "o"."installment_no",
    "o"."total_installments",
    "o"."split_group_id",
    "o"."cancelled_at",
    "o"."cancelled_reason",
    "o"."is_reconciled",
    "o"."unreconciled_reason",
    "o"."unreconciled_at",
    "o"."attachments",
    "o"."created_at",
    "o"."updated_at",
    COALESCE("sum"("p"."amount") FILTER (WHERE (("p"."reversed_at" IS NULL) AND ("p"."reversal_of" IS NULL))), (0)::numeric) AS "paid_amount",
    ("o"."original_amount" - COALESCE("sum"("p"."amount") FILTER (WHERE (("p"."reversed_at" IS NULL) AND ("p"."reversal_of" IS NULL))), (0)::numeric)) AS "remaining_amount",
    "count"("p"."id") FILTER (WHERE (("p"."reversed_at" IS NULL) AND ("p"."reversal_of" IS NULL))) AS "payment_count",
    "round"(
        CASE
            WHEN ("o"."original_amount" > (0)::numeric) THEN ((COALESCE("sum"("p"."amount") FILTER (WHERE (("p"."reversed_at" IS NULL) AND ("p"."reversal_of" IS NULL))), (0)::numeric) / "o"."original_amount") * (100)::numeric)
            ELSE (0)::numeric
        END, 2) AS "paid_pct",
        CASE
            WHEN ("o"."cancelled_at" IS NOT NULL) THEN 'cancelled'::"text"
            WHEN (("o"."original_amount" - COALESCE("sum"("p"."amount") FILTER (WHERE (("p"."reversed_at" IS NULL) AND ("p"."reversal_of" IS NULL))), (0)::numeric)) <= (0)::numeric) THEN 'paid'::"text"
            WHEN (COALESCE("sum"("p"."amount") FILTER (WHERE (("p"."reversed_at" IS NULL) AND ("p"."reversal_of" IS NULL))), (0)::numeric) > (0)::numeric) THEN 'partial'::"text"
            WHEN ("o"."due_date" < CURRENT_DATE) THEN 'overdue'::"text"
            ELSE 'open'::"text"
        END AS "derived_status",
    "o"."global_category_id",
    "o"."order_id"
   FROM ("public"."financial_obligations" "o"
     LEFT JOIN "public"."obligation_payments" "p" ON (("o"."id" = "p"."obligation_id")))
  GROUP BY "o"."id";



