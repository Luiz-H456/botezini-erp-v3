    NULL::"text" AS "description",
    NULL::numeric(15,2) AS "original_amount",
    NULL::"date" AS "due_date",
    NULL::"date" AS "issue_date",
    NULL::"text" AS "category",
    NULL::"uuid" AS "cost_center_id",
    NULL::"text" AS "notes",
    NULL::"uuid" AS "client_id",
    NULL::"uuid" AS "supplier_id",
    NULL::"uuid" AS "default_account_id",
    NULL::boolean AS "is_recurring",
    NULL::"uuid" AS "recurrence_id",
    NULL::integer AS "installment_no",
    NULL::integer AS "total_installments",
    NULL::"uuid" AS "split_group_id",
    NULL::timestamp with time zone AS "cancelled_at",
    NULL::"text" AS "cancelled_reason",
    NULL::boolean AS "is_reconciled",
    NULL::"text" AS "unreconciled_reason",
    NULL::timestamp with time zone AS "unreconciled_at",
    NULL::"jsonb" AS "attachments",
    NULL::timestamp with time zone AS "created_at",
    NULL::timestamp with time zone AS "updated_at",
    NULL::numeric AS "paid_amount",
    NULL::numeric AS "remaining_amount",
    NULL::bigint AS "payment_count",
    NULL::numeric AS "paid_pct",
    NULL::"text" AS "derived_status",
    NULL::"uuid" AS "global_category_id",
    NULL::"uuid" AS "order_id";


